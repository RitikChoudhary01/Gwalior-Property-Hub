# ============================================================
# Gwalior Property Hub — environment configuration
# Copy this file to .env and fill in the values.
# ============================================================

# --- Database -------------------------------------------------------------
# Local development (default — demo data lives in db/custom.db):
DATABASE_URL=file:/home/z/my-project/db/custom.db

# Production / Supabase — dual-pooler setup (run `bun scripts/use-supabase.mjs`
# to switch; it pushes the schema and carries over ALL existing data):
#   DATABASE_URL  — transaction-mode pooler (:6543, ?pgbouncer=true) — runtime
#   DIRECT_URL    — session-mode pooler (:5432) — migrations / db push
#                   (auto-derived from DATABASE_URL when commented out)
# Copy both from Settings → Database → Connection string (URI):
# DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# --- Supabase (required for the switch; optional in local dev) ------------
# Project Settings → API:
# SUPABASE_URL=https://xxxxxxxxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...   (server-side only — never expose)
# SUPABASE_BUCKET=uploads                    (optional, default: uploads)

# --- Optional notification channels (skip gracefully when unset) ----------
# EMAIL_PROVIDER_URL=
# EMAIL_PROVIDER_KEY=
# EMAIL_FROM="Gwalior Property Hub <no-reply@gwaliorpropertyhub.in>"
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
