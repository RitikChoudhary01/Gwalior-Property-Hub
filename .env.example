# ============================================================
# Vasati — environment configuration
# Copy this file to .env and fill in the values.
# ============================================================

# --- Database -------------------------------------------------------------
# Local development (default — demo data lives in db/custom.db):
DATABASE_URL=file:/home/z/my-project/db/custom.db

# Production / Supabase (run `bun scripts/use-supabase.mjs` to switch —
# it pushes the schema and carries over ALL existing data, nothing deleted):
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# --- Supabase (required for the switch; optional in local dev) ------------
# Project Settings → API:
# SUPABASE_URL=https://xxxxxxxxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...   (server-side only — never expose)
# SUPABASE_BUCKET=uploads                    (optional, default: uploads)

# --- Optional notification channels (skip gracefully when unset) ----------
# EMAIL_PROVIDER_URL=
# EMAIL_PROVIDER_KEY=
# EMAIL_FROM="Vasati <no-reply@vasati.in>"
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
